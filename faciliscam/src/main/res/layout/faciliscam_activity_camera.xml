<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/faciliscam_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/faciliscam_capture_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/white" />

    <FrameLayout
        android:id="@+id/faciliscam_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/faciliscam_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:background="@drawable/faciliscam_round_button"
            android:contentDescription="@string/faciliscam_close"
            android:src="@drawable/faciliscam_ic_close" />

        <ImageButton
            android:id="@+id/faciliscam_flash"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/faciliscam_round_button"
            android:contentDescription="@string/faciliscam_flash_off"
            android:src="@drawable/faciliscam_ic_flash_off"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/faciliscam_shutter"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="32dp"
            android:background="@drawable/faciliscam_shutter"
            android:contentDescription="@string/faciliscam_take_photo" />

        <ImageButton
            android:id="@+id/faciliscam_flip"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="40dp"
            android:layout_marginBottom="44dp"
            android:background="@drawable/faciliscam_round_button"
            android:contentDescription="@string/faciliscam_switch_camera"
            android:src="@drawable/faciliscam_ic_flip"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/faciliscam_permission_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/faciliscam_permission_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/faciliscam_permission_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</FrameLayout>
